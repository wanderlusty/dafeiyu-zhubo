[Unit]
Description=XiaoBai official QQ Bot adapter
After=network-online.target xiaobai-dsh.service
Wants=network-online.target
Requires=xiaobai-dsh.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=xiaobai
Group=xiaobai
WorkingDirectory=/srv/xiaobai/app/workspaces/platform/qqbot-bridge
Environment=HOME=/home/xiaobai
EnvironmentFile=/srv/xiaobai/data/qqbot/qqbot.env
ExecStart=/usr/local/bin/node /srv/xiaobai/app/workspaces/platform/qqbot-bridge/main.mjs
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/xiaobai/data/qqbot

[Install]
WantedBy=multi-user.target
