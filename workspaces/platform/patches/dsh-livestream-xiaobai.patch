@@ -0,0 +1,19 @@
+"""Generate one MP3 from stdin with the selected Edge neural voice."""
+
+import asyncio
+import sys
+
+import edge_tts
+
+
+async def main() -> None:
+    if len(sys.argv) != 3:
+        raise SystemExit("usage: edge-tts.py VOICE OUTPUT.mp3")
+    sys.stdin.reconfigure(encoding="utf-8")
+    text = sys.stdin.read().strip()
+    if not text:
+        raise ValueError("empty speech text")
+    await edge_tts.Communicate(text, sys.argv[1]).save(sys.argv[2])
+
+
+asyncio.run(main())
