@@ -0,0 +1,138 @@
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { expect, it } from 'vitest';
+import { LiveShow } from '../src/body/show';
+import type { StageEvent } from '../src/stage/protocol';
+
+async function finishOpening(show: LiveShow): Promise<void> {
+  await new Promise((resolve) => setTimeout(resolve, 350));
+  show.turnEnded('song-test');
+}
+
+it('shows a requested song progressing from learning to actual playback', async () => {
+  const show = new LiveShow(
+    { push: async () => true, synthesize: async () => null },
+    { dataDir: mkdtempSync(join(tmpdir(), 'dsh-songs-')), names: ['小白'] },
+  );
+  const events: StageEvent[] = [];
+  const unsubscribe = show.stage.subscribe((event) => {
+    events.push(event);
+    if (event.type === 'say') show.stage.said(event.id);
+  });
+  try {
+    show.goLive('song-test');
+    await finishOpening(show);
+    const id = show.addSong('断桥残雪');
+    show.updateSong(id, 'ready');
+    const replay: StageEvent[] = [];
+    const stopReplay = show.stage.subscribe((event) => replay.push(event), false);
+    expect(replay.find((event) => event.type === 'songs')).toMatchObject({ items: [{ id, title: '断桥残雪', state: 'ready' }] });
+    stopReplay();
+    expect(await show.singPrepared('断桥残雪', new Uint8Array(10_001), 5, new AbortController().signal, id)).toBe(true);
+    expect(events.filter((event) => event.type === 'songs').map((event) => event.items[0]?.state).filter(Boolean))
+      .toEqual(['learning', 'ready', 'singing', 'done']);
+  } finally {
+    unsubscribe();
+    show.dispose();
+  }
+});
+
+it('keeps eight active requests in order and frees a slot after a song ends', async () => {
+  const show = new LiveShow(
+    { push: async () => true, synthesize: async () => null },
+    { dataDir: mkdtempSync(join(tmpdir(), 'dsh-songs-')), names: ['小白'] },
+  );
+  try {
+    show.goLive('song-test');
+    await finishOpening(show);
+    const ids = Array.from({ length: 8 }, (_, index) => show.addSong(`歌曲${index + 1}`));
+    expect(show.pendingSongCount).toBe(8);
+    expect(() => show.addSong('第九首')).toThrow('点歌队列已满');
+    show.updateSong(ids[0], 'done');
+    expect(show.pendingSongCount).toBe(7);
+    expect(show.addSong('第九首')).toBeTruthy();
+    expect(show.pendingSongCount).toBe(8);
+  } finally { show.dispose(); }
+});
+
+it('marks a song failed when playback is interrupted before acknowledgement', async () => {
+  const show = new LiveShow(
+    { push: async () => true, synthesize: async () => null },
+    { dataDir: mkdtempSync(join(tmpdir(), 'dsh-songs-')), names: ['小白'] },
+  );
+  const controller = new AbortController();
+  const events: StageEvent[] = [];
+  const unsubscribe = show.stage.subscribe((event) => {
+    events.push(event);
+    if (event.type === 'say') controller.abort();
+  });
+  try {
+    show.goLive('song-test');
+    await finishOpening(show);
+    const id = show.addSong('测试歌曲', 'ready');
+    expect(await show.singPrepared('测试歌曲', new Uint8Array(10_001), 5, controller.signal, id)).toBe(false);
+    expect(events.filter((event) => event.type === 'songs').at(-1)).toMatchObject({ items: [{ id, state: 'failed' }] });
+  } finally {
+    unsubscribe();
+    show.dispose();
+  }
+});
+
+it('waits for the current video and introduces a song before playback', async () => {
+  const show = new LiveShow(
+    { push: async () => true, synthesize: async () => null },
+    { dataDir: mkdtempSync(join(tmpdir(), 'dsh-songs-')), names: ['小白'] },
+  );
+  const events: StageEvent[] = [];
+  const unsubscribe = show.stage.subscribe((event) => {
+    events.push(event);
+    if (event.type === 'say') show.stage.said(event.id);
+  });
+  try {
+    show.goLive('song-test');
+    await finishOpening(show);
+    show.playVideo({ bvid: 'BV1test', title: '测试视频', up: '测试', url: 'https://example.com/test.mp4', fromSec: 0, untilSec: 20 });
+    const songId = show.addSong('明明就', 'ready');
+    const playing = show.singPrepared('明明就', new Uint8Array(10_001), 5, new AbortController().signal, songId);
+    await new Promise((resolve) => setTimeout(resolve, 30));
+    expect(events.some((event) => event.type === 'say' && event.song)).toBe(false);
+    show.stopVideo();
+    expect(await playing).toBe(true);
+    expect(events.filter((event) => event.type === 'say').map((event) => event.text))
+      .toEqual(['刚才的视频看完啦。接下来唱《明明就》的一小段。', '演唱《明明就》']);
+    expect(events.find((event) => event.type === 'say' && event.song)).toBeDefined();
+  } finally {
+    unsubscribe();
+    show.dispose();
+  }
+});
+
+it('finishes one requested song before introducing the next', async () => {
+  const show = new LiveShow(
+    { push: async () => true, synthesize: async () => null },
+    { dataDir: mkdtempSync(join(tmpdir(), 'dsh-songs-')), names: ['小白'] },
+  );
+  const spoken: string[] = [];
+  const unsubscribe = show.stage.subscribe((event) => {
+    if (event.type !== 'say') return;
+    spoken.push(event.text);
+    show.stage.said(event.id);
+  });
+  try {
+    show.goLive('song-test');
+    await finishOpening(show);
+    const [first, second] = await Promise.all([
+      show.singPrepared('明明就', new Uint8Array(10_001), 5, new AbortController().signal),
+      show.singPrepared('至少还有你', new Uint8Array(10_001), 5, new AbortController().signal),
+    ]);
+    expect([first, second]).toEqual([true, true]);
+    expect(spoken).toEqual([
+      '这首准备好啦，接下来唱《明明就》的一小段。', '演唱《明明就》',
+      '这首准备好啦，接下来唱《至少还有你》的一小段。', '演唱《至少还有你》',
+    ]);
+  } finally {
+    unsubscribe();
+    show.dispose();
+  }
+});
