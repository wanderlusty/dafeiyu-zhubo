@@ -0,0 +1,17 @@
+/** Only accept explicit requests with a song title; vague wishes stay with the chat agent. */
+export function songIntent(text: string): { song: string; artist: string } | null {
+  const request = text.match(/(?:想听|点歌|唱一首|唱首|来一首|来首)(?:你唱|小白唱|一下)?\s*(.+)/u)
+    ?? text.match(/第[一二三四1234]首(?:歌)?(?:是|要|点)?\s*(.+)/u);
+  if (!request) return null;
+  const rest = request[1].trim();
+  const quoted = rest.match(/^(?:(.{1,18}?)的)?[《「](.{1,40}?)[》」]/u);
+  if (quoted) return { artist: (quoted[1] ?? '').trim(), song: quoted[2].trim() };
+  const phrase = rest.split(/[，。！？?,!]/u, 1)[0]
+    .replace(/(?:可以吗|能不能|好不好|给我听|唱一小段|唱一段|谢谢).*$/u, '')
+    .replace(/(?:这首歌|这首)$/u, '').trim();
+  const separated = phrase.match(/^(.{1,18}?)的(.{1,40})$/u);
+  const artist = separated ? separated[1].trim() : '';
+  const song = (separated ? separated[2] : phrase).trim();
+  if (!song || song.length > 40 || /^(?:歌|一首歌|点歌|什么歌|任意一首)$/u.test(song)) return null;
+  return { song, artist };
+}
