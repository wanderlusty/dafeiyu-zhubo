+import { spawn } from 'node:child_process';
+import { mkdtemp, readFile, rmdir, unlink } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+/** Optional neural voice for local rehearsals; the Python environment is isolated from DSH. */
+export async function edgeSpeech(text: string, signal: AbortSignal, python: string, script: string, voice: string): Promise<Uint8Array> {
+  const dir = await mkdtemp(join(tmpdir(), 'ds-edge-tts-'));
+  const mp3 = join(dir, 'speech.mp3');
+  try {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(python, [script, voice, mp3], { stdio: ['pipe', 'ignore', 'pipe'], windowsHide: true, signal });
+      let errors = '';
+      child.stderr.setEncoding('utf8');
+      child.stderr.on('data', (part: string) => { errors = (errors + part).slice(-2000); });
+      child.on('error', reject);
+      child.on('close', (code) => code === 0 ? resolve() : reject(new Error(`Edge TTS exited ${code}: ${errors}`)));
+      child.stdin.end(text, 'utf8');
+    });
+    const audio = await readFile(mp3);
+    if (audio.length < 1000) throw new Error('Edge TTS returned empty audio');
+    return audio;
+  } finally {
+    await unlink(mp3).catch(() => {});
+    await rmdir(dir).catch(() => {});
+  }
+}
