@@ -0,0 +1,76 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const mocks = vi.hoisted(() => ({
+  stopRoom: vi.fn(async () => {}),
+  stopStreaming: vi.fn(async () => {}),
+  closeObs: vi.fn(),
+  startRoom: vi.fn(async () => ({ kind: 'live', stream: { addr: 'rtmp://example/', code: 'secret', protocol: 'rtmp' }, srt: null })),
+  startStreaming: vi.fn(async () => {}),
+  prepareObs: vi.fn(async () => { throw new Error('OBS preparation failed'); }),
+  streamHealth: vi.fn(async () => ({ active: false })),
+}));
+
+vi.mock('../src/body/biliRoom', () => ({
+  BiliRoom: class {
+    async whoami() { return { loggedIn: true, uid: '1', name: 'test' }; }
+    async ensureRoom() { return 123; }
+    async preLive() { return { title: '', areaId: 371, areaName: '', coverUrl: '' }; }
+    async start() { return mocks.startRoom(); }
+    async stop(roomId: number) { await mocks.stopRoom(roomId); }
+  },
+  sameCover: vi.fn(),
+}));
+
+vi.mock('../src/body/obs', () => ({
+  connectObs: vi.fn(async () => ({ close: mocks.closeObs })),
+  prepareObs: mocks.prepareObs,
+  startStreaming: mocks.startStreaming,
+  stopStreaming: mocks.stopStreaming,
+  streamHealth: mocks.streamHealth,
+}));
+
+describe('broadcast rollback', () => {
+  beforeEach(() => vi.clearAllMocks());
+  const options = () => ({
+    cookie: async () => 'cookie', stageUrl: () => 'http://localhost/stage', areaId: () => 371,
+    title: () => null, protocol: () => 'rtmp' as const, kbps: () => 4500, cover: () => null,
+    onRoom: vi.fn(),
+  });
+
+  it('ends the Bilibili live room when OBS preparation fails after StartLive', async () => {
+    const { Broadcast } = await import('../src/body/broadcast');
+    const broadcast = new Broadcast(options());
+    broadcast.start();
+    await vi.waitFor(() => expect(broadcast.status().phase).toBe('error'));
+    expect(broadcast.status().error).toContain('OBS preparation failed');
+    expect(mocks.stopStreaming).toHaveBeenCalledOnce();
+    expect(mocks.closeObs).toHaveBeenCalledOnce();
+    expect(mocks.stopRoom).toHaveBeenCalledWith(123);
+  });
+
+  it('ends a late Bilibili start when the owner cancels while the request is pending', async () => {
+    const { Broadcast } = await import('../src/body/broadcast');
+    let release!: (value: Awaited<ReturnType<typeof mocks.startRoom>>) => void;
+    mocks.startRoom.mockImplementationOnce(() => new Promise(resolve => { release = resolve; }));
+    const broadcast = new Broadcast(options());
+    broadcast.start();
+    await vi.waitFor(() => expect(mocks.startRoom).toHaveBeenCalled());
+    await broadcast.stop();
+    release({ kind: 'live', stream: { addr: 'rtmp://example/', code: 'secret', protocol: 'rtmp' }, srt: null });
+    await vi.waitFor(() => expect(mocks.stopRoom).toHaveBeenCalledWith(123));
+    expect(mocks.startStreaming).not.toHaveBeenCalled();
+    expect(broadcast.status().phase).toBe('idle');
+  });
+
+  it('ends the Bilibili live room when OBS stops after streaming begins', async () => {
+    const { Broadcast } = await import('../src/body/broadcast');
+    mocks.prepareObs.mockResolvedValueOnce(undefined as never);
+    const broadcast = new Broadcast(options());
+    broadcast.start();
+    await vi.waitFor(() => expect(broadcast.status().phase).toBe('streaming'));
+    await vi.waitFor(() => expect(broadcast.status().phase).toBe('error'), { timeout: 5000 });
+    expect(broadcast.status().error).toContain('已向 B 站下播');
+    expect(mocks.stopRoom).toHaveBeenCalledWith(123);
+  });
+
+});
