+import { createServer } from 'node:http';
+import { afterEach, expect, it } from 'vitest';
+import { StageServer } from '../src/body/server';
+import { Stage } from '../src/body/stage';
+
+const servers: Array<{ close(): void }> = [];
+afterEach(() => { for (const server of servers.splice(0)) server.close(); });
+
+it('keeps the CDN request alive after the browser GET request is complete', async () => {
+  const upstream = createServer((req, res) => {
+    expect(req.headers.referer).toBe('https://www.bilibili.com/');
+    res.writeHead(206, { 'content-type': 'video/mp4', 'content-range': 'bytes 0-7/8' });
+    res.write('video');
+    setTimeout(() => res.end('123'), 80);
+  });
+  await new Promise<void>((resolve) => upstream.listen(0, '127.0.0.1', resolve));
+  servers.push(upstream);
+  const upstreamPort = (upstream.address() as { port: number }).port;
+
+  const stage = new StageServer({
+    port: 0, token: 'test-token', packageDir: process.cwd(), stage: new Stage(),
+    packs: {} as never, current: () => ({ character: 'none', template: 'none' }),
+    media: { source: () => `http://127.0.0.1:${upstreamPort}/clip`, report: () => {} },
+  });
+  await stage.start();
+  servers.push({ close: () => stage.stop() });
+  const port = (stage as unknown as { server: { address(): { port: number } } }).server.address().port;
+  const response = await fetch(`http://127.0.0.1:${port}/video?id=clip&token=test-token`, { headers: { range: 'bytes=0-7' } });
+  expect(response.status).toBe(206);
+  expect(await response.text()).toBe('video123');
+});
