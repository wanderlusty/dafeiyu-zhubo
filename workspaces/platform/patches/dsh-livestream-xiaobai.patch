@@ -0,0 +1,32 @@
+/** Opt-in Windows SAPI rehearsal voice. Produces MP3 because the stage expects audio/mpeg. */
+import { spawn } from 'node:child_process';
+import { mkdtemp, readFile, rmdir, unlink } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+function run(exe: string, args: string[], input: string, signal: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(exe, args, { stdio: ['pipe', 'ignore', 'pipe'], windowsHide: true, signal });
+    let errors = '';
+    child.stderr.setEncoding('utf8');
+    child.stderr.on('data', (part: string) => { errors = (errors + part).slice(-2000); });
+    child.on('error', reject);
+    child.on('close', (code) => code === 0 ? resolve() : reject(new Error(`${exe} exited ${code}: ${errors}`)));
+    child.stdin.end(input, 'utf8');
+  });
+}
+
+export async function localSpeech(text: string, signal: AbortSignal, script: string, ffmpeg: string): Promise<Uint8Array> {
+  if (!ffmpeg) throw new Error('DS_LOCAL_FFMPEG 未设置');
+  const dir = await mkdtemp(join(tmpdir(), 'ds-local-tts-'));
+  const wav = join(dir, 'speech.wav'), mp3 = join(dir, 'speech.mp3');
+  try {
+    await run('powershell.exe', ['-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', script, '-WavPath', wav], text, signal);
+    await run(ffmpeg, ['-hide_banner', '-loglevel', 'error', '-y', '-i', wav, '-codec:a', 'libmp3lame', '-q:a', '4', mp3], '', signal);
+    return await readFile(mp3);
+  } finally {
+    await unlink(wav).catch(() => {});
+    await unlink(mp3).catch(() => {});
+    await rmdir(dir).catch(() => {});
+  }
+}
